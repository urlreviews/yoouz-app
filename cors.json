[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Content-Range",
      "Range",
      "Accept-Ranges",
      "Origin",
      "Access-Control-Allow-Origin",
      "Access-Control-Allow-Headers",
      "Authorization",
      "x-goog-resumable"
    ],
    "maxAgeSeconds": 3600
  }
]
