# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for live Google Maps and Places API search data.
# Configured via Settings -> Secrets in AI Studio.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"





# Cloudinary credentials for video hosting (Optional)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Bunny CDN Video Hosting (Optional, overrides local/firebase storage)
# BUNNY_STORAGE_API_KEY=
# BUNNY_STORAGE_ZONE_NAME=
# BUNNY_PULL_ZONE_URL=
# BUNNY_STORAGE_REGION=
RESEND_API_KEY=
